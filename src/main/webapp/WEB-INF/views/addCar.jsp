
<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<html>
<head>
    <title>Title</title>
</head>
<body>
 <h3> Welcome To Car Registration Page</h3>
<form action="carReg" method="post">
    <label>Car Brand</label>
    <input type="text" name="carBrand" placeholder="Enter Your Car Brand" required>

    <label>Model Name</label>
    <input type="text" name="modelName" placeholder="Enter Your Model Name" required>

    <label>Vehicle Type</label>
    <input type="text" name="vehicleType" placeholder="Enter Your Vehicle Type" required>

    <label>Manufacturing Year</label>
    <input type="text" name="nanufacturingYear" placeholder="Enter Car Manufacturing Year  " required>

    <label>Colour</label>
    <input type="text" name="colour" placeholder="Enter Your Car Colour" required>

    <label>Fuel Type</label>
    <input type="text" name="fuelType" placeholder="Enter Your Car Fuel Type" required>

    <label>Transmission Type</label>
    <input type="text" name="transmissionType" placeholder="Enter Your Car Transmission Type" required>

    <label>Seating Capacity</label>
    <input type="text" name="seatingCapacity" placeholder="Enter Your Car Seating Capacity" required>

    <label>Mileage</label>
    <input type="text" name="mileage" placeholder="Enter Your Car Mileage" required>

    <label>Number Of Car</label>
    <input type="text" name="numberPlate" placeholder="Enter Your Car Number" required>

    <label>Insurance Expiry Date</label>
    <input type="text" name="insuranceDate" placeholder="Enter Your Car Insurance Expiry Date" required>

    <label>RC Number</label>
    <input type="text" name="rcNumber" placeholder="Enter Your Car RC Number" required>

    <label>Transmission Type</label>
    <input type="text" name="transmissionType" placeholder="Enter Your Car Transmission Type" required>

</form>
</body>
</html>
